{
  "name": "water-voice",
  "version": "1.4.0",
  "description": "AI Voice Dictation powered by Gemini API",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"webpack --watch --mode development\" \"wait-on dist/renderer.js && electron .\"",
    "build": "webpack --mode production",
    "dist": "npm run build && electron-builder --config electron-builder.config.js",
    "pack": "npm run dist",
    "test": "node --test tests/",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "volta": {
    "node": "20.19.0",
    "npm": "10.8.2"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@eslint/js": "^9.39.5",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.10.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.3.0",
    "html-webpack-plugin": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "style-loader": "^3.3.4",
    "wait-on": "^7.2.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
